# Optional features must be disabled until their live configuration is verified.
ENABLE_INSPECTOR=false
ENABLE_EXA=false
ENABLE_AMBIGUOUS=false
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
