# Configuration contract only; application bootstrap is task I-01.
# Never put real secrets in this tracked file. See docs/INFRASTRUCTURE.md.
APP_BASE_URL=http://localhost:3000
DATABASE_URL=
DATABASE_URL_UNPOOLED=
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=
# Optional CLI/CI deployment authentication only; not a web/task runtime secret.
TRIGGER_ACCESS_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
# Optional: only after explicitly authorizing the scopes needed for thread reads.
SLACK_THREAD_READ_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
