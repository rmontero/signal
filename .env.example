# Signal autonomous-coding pre-flight configuration.
# Never put real secrets in this tracked file. Copy to an ignored .env and fill
# values from the provider dashboards. See docs/INFRASTRUCTURE.md.
# Core values must be present before autonomous agents are enabled.
APP_BASE_URL=http://localhost:3000
# Server-only tenant context for the single-workspace dashboard during MVP.
# Never accept this value from a browser request.
SIGNAL_DASHBOARD_TENANT_ID=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
TRIGGER_PROJECT_REF=proj_cehggonaqopuuhibihif
TRIGGER_SECRET_KEY=
# Optional CLI/CI deployment authentication only; never a web/task runtime secret.
TRIGGER_ACCESS_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
# Optional: use only after explicitly authorizing the scopes needed for thread reads.
SLACK_THREAD_READ_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
CRON_SECRET=
SIGNAL_PILOT_CONFIG_PATH=config/pilot.local.json

# Optional features stay disabled until their live configuration is verified.
ENABLE_INSPECTOR=false
ENABLE_EXA=false
ENABLE_AMBIGUOUS=false
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
EXA_API_KEY=
AMBIGUOUS_API_KEY=

# Mozilla.ai is offline evaluation tooling and has no runtime credential. Keep
# evaluation fixtures synthetic; do not add an OPENAI_API_KEY because OpenRouter
# is Signal's sole model route.
